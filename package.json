{
  "name": "mythic-superhero-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contracts": "bash scripts/validate-contracts.sh",
    "test:e2e": "playwright test",
    "check": "npm run generate && git diff --exit-code contracts/generated && npm run typecheck && npm run lint && npm test && npm run build",
    "generate": "node scripts/generate-contracts.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "jsdom": "27.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
