{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mythic-rpg.local/c1/schemas/events/core-loop.schema.json",
  "title": "Mythic RPG C1 Core Loop Events",
  "oneOf": [
    {
      "$ref": "#/$defs/CanonicalStateCommitted"
    },
    {
      "$ref": "#/$defs/AccessibleProjectionUpdated"
    },
    {
      "$ref": "#/$defs/DecisionWindowChanged"
    },
    {
      "$ref": "#/$defs/CommandStatusChanged"
    },
    {
      "$ref": "#/$defs/RecoveryRequired"
    },
    {
      "$ref": "#/$defs/AccessibilityAnnouncement"
    }
  ],
  "$defs": {
    "CanonicalStateCommitted": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "canonical_state_committed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "previous_state_version",
                "new_state_version",
                "committed_event_ids",
                "receipt_id"
              ],
              "properties": {
                "previous_state_version": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/StateVersion"
                },
                "new_state_version": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/StateVersion"
                },
                "committed_event_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                  }
                },
                "receipt_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                }
              }
            }
          }
        }
      ]
    },
    "AccessibleProjectionUpdated": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "accessible_projection_updated"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payload_types",
                "knowledge_snapshot_id",
                "freshness"
              ],
              "properties": {
                "payload_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "knowledge_snapshot_id": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/KnowledgeSnapshotId"
                },
                "freshness": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/Freshness"
                }
              }
            }
          }
        }
      ]
    },
    "DecisionWindowChanged": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "decision_window_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "window_id",
                "status",
                "legal_response_types"
              ],
              "properties": {
                "window_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "opened",
                    "updated",
                    "closed",
                    "expired",
                    "resolved"
                  ]
                },
                "legal_response_types": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CommandStatusChanged": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "command_status_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command_id",
                "receipt_id",
                "status"
              ],
              "properties": {
                "command_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "receipt_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted_pending",
                    "committed",
                    "rejected",
                    "replan_required",
                    "conflict",
                    "queued",
                    "retryable_failure",
                    "unknown_commit",
                    "canceled"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "RecoveryRequired": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "recovery_required"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command_id",
                "outcome",
                "recovery"
              ],
              "properties": {
                "command_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "outcome": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/PublicOutcome"
                },
                "recovery": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/RecoveryInstruction"
                }
              }
            }
          }
        }
      ]
    },
    "AccessibilityAnnouncement": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/EventEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "accessibility_announcement"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "semantic"
              ],
              "properties": {
                "semantic": {
                  "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/AccessibilitySemantic"
                }
              }
            }
          }
        }
      ]
    }
  }
}
