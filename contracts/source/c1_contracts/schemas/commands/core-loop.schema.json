{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mythic-rpg.local/c1/schemas/commands/core-loop.schema.json",
  "title": "Mythic RPG C1 Core Loop Commands and Receipts",
  "oneOf": [
    {
      "$ref": "#/$defs/InterpretIntentCommand"
    },
    {
      "$ref": "#/$defs/ReviseProposalCommand"
    },
    {
      "$ref": "#/$defs/ForecastProposalCommand"
    },
    {
      "$ref": "#/$defs/CommitActionCommand"
    },
    {
      "$ref": "#/$defs/ResolveCommitStatusCommand"
    },
    {
      "$ref": "#/$defs/CommandReceipt"
    }
  ],
  "$defs": {
    "InterpretIntentCommand": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/CommandEnvelope"
        },
        {
          "required": [],
          "properties": {
            "command_type": {
              "const": "interpret_intent"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "draft_text",
                "context_refs",
                "explanation_depth"
              ],
              "properties": {
                "draft_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "requested_goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "context_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                  }
                },
                "explanation_depth": {
                  "type": "string",
                  "enum": [
                    "minimal",
                    "standard",
                    "detailed"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "ReviseProposalCommand": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/CommandEnvelope"
        },
        {
          "required": [
            "proposal_id"
          ],
          "properties": {
            "command_type": {
              "const": "revise_proposal"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposal_version",
                "revisions"
              ],
              "properties": {
                "proposal_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "revisions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "value"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "goal",
                          "method",
                          "target",
                          "scope",
                          "timing",
                          "resource",
                          "assumption"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "array",
                          "object"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ForecastProposalCommand": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/CommandEnvelope"
        },
        {
          "required": [
            "proposal_id"
          ],
          "properties": {
            "command_type": {
              "const": "forecast_proposal"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposal_version"
              ],
              "properties": {
                "proposal_version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    },
    "CommitActionCommand": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/CommandEnvelope"
        },
        {
          "required": [
            "proposal_id"
          ],
          "properties": {
            "command_type": {
              "const": "commit_action"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposal_version",
                "final_confirmation",
                "acknowledged_consequence_ids"
              ],
              "properties": {
                "proposal_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "final_confirmation": {
                  "const": true
                },
                "acknowledged_consequence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ResolveCommitStatusCommand": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/CommandEnvelope"
        },
        {
          "required": [],
          "properties": {
            "command_type": {
              "const": "resolve_commit_status"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "original_command_id",
                "original_idempotency_key"
              ],
              "properties": {
                "original_command_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "original_idempotency_key": {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 160
                }
              }
            }
          }
        }
      ]
    },
    "CommandReceipt": {
      "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/ReceiptEnvelope"
    }
  }
}
