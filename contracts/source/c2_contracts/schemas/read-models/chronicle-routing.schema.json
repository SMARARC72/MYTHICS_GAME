{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mythic-rpg.local/c2/schemas/read-models/chronicle-routing.schema.json",
  "title": "Mythic RPG C2 Chronicle Consequence Routing Read Models",
  "oneOf": [
    {
      "$ref": "#/$defs/ChronicleConsequenceBundle"
    }
  ],
  "$defs": {
    "ChronicleConsequenceBundle": {
      "allOf": [
        {
          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/ReadModelEnvelope"
        },
        {
          "properties": {
            "payload_type": {
              "const": "chronicle_consequence_bundle"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bundle_id",
                "source_event_ids",
                "headline",
                "summary",
                "surface_projections",
                "consequence_links",
                "continuation_prompts"
              ],
              "properties": {
                "bundle_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                },
                "source_event_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                  }
                },
                "headline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 220
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2400
                },
                "surface_projections": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "surface",
                      "record_ref",
                      "summary",
                      "facts"
                    ],
                    "properties": {
                      "surface": {
                        "type": "string",
                        "enum": [
                          "character",
                          "company",
                          "holdings",
                          "world",
                          "chronicle"
                        ]
                      },
                      "record_ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 800
                      },
                      "facts": {
                        "type": "array",
                        "items": {
                          "$ref": "https://contracts.mythic-rpg.local/c1/schemas/common/common.schema.json#/$defs/KnowledgeFact"
                        }
                      }
                    }
                  }
                },
                "consequence_links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "link_id",
                      "kind",
                      "target_ref",
                      "label"
                    ],
                    "properties": {
                      "link_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "wound",
                          "relationship",
                          "custody",
                          "project",
                          "journey",
                          "site",
                          "case",
                          "front",
                          "legal",
                          "succession",
                          "comic_continuity"
                        ]
                      },
                      "target_ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      }
                    }
                  }
                },
                "continuation_prompts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "prompt_id",
                      "label",
                      "target_surface"
                    ],
                    "properties": {
                      "prompt_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "target_surface": {
                        "type": "string",
                        "enum": [
                          "stage",
                          "character",
                          "company",
                          "holdings",
                          "world",
                          "chronicle"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
